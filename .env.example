# Contact form (app/contact/actions.ts). Without RESEND_API_KEY the form falls
# back to opening the visitor's mail app.
RESEND_API_KEY=
# Where notes are delivered. Defaults to site.email.
CONTACT_TO=
# Sender address. Must be on a domain verified in Resend; defaults to
# Resend's onboarding@resend.dev, which only delivers to your own account.
CONTACT_FROM=
